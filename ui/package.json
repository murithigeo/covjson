{
	"name": "@murithigeo/covjson-ui",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build:components": "svebcomponents",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "playwright install && svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/client/index.d.ts",
			"svelte": "./dist/client-svelte/index.js",
			"default": "./dist/client/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@murithigeo/covjson-core": "^0.1.0",
		"@murithigeo/covjson-maplibre": "^0.1.0",
		"@playwright/test": "^1.62.1",
		"@svebcomponents/build": "^0.7.4",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/d3-scale": "^4.0.9",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.3",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"layerchart": "^2.3.1",
		"mode-watcher": "^1.1.0",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"publint": "^0.3.24",
		"shadcn-svelte": "^1.5.1",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^2.1.0"
	},
	"keywords": [
		"svelte"
	],
	"dependencies": {
		"@lucide/svelte": "^1.35.0",
		"d3-scale": "^4.0.2",
		"maplibre-gl": "^5.24.0",
		"sveaflet": "^0.1.4",
		"svelte-awesome-color-picker": "^4.1.3",
		"svelte-maplibre": "^1.3.0"
	}
}
