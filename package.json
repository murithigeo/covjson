{
	"name": "@murithigeo/covjson",
	"version": "0.1.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "playwright install && svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test"
	},
	"customElements": "custom-elements.json",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"custom-elements.json"
	],
	"sideEffects": [
		"**/*.css"
	],
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#app.css": "./src/routes/layout.css"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"exports": {
		"./core": {
			"types": "./dist/core/index.d.ts",
			"default": "./dist/core/index.js"
		},
		"./plugin-maplibre": {
			"types": "./dist/plugin-maplibre/index.d.ts",
			"default": "./dist/plugin-maplibre/index.js"
		},
		"./plugin-ui/coverage": {
			"types": "./dist/plugin-ui/client/Coverage.d.ts",
			"default": "./dist/plugin-ui/client/Coverage.js"
		},
		"./plugin-ui/coverage/svelte": {
			"types": "./dist/plugin-ui/client/Coverage.svelte-types.d.ts"
		},
		"./plugin-ui/coverage/ssr": {
			"types": "./dist/plugin-ui/ssr/Coverage-ssr.d.ts",
			"default": "./dist/plugin-ui/ssr/Coverage-ssr.js"
		},
		"./plugin-ui/parameter": {
			"types": "./dist/plugin-ui/client/Parameter.d.ts",
			"default": "./dist/plugin-ui/client/Parameter.js"
		},
		"./plugin-ui/parameter/ssr": {
			"types": "./dist/plugin-ui/ssr/Parameter-ssr.d.ts",
			"default": "./dist/plugin-ui/ssr/Parameter-ssr.js"
		},
		"./plugin-ui/parameter/svelte": {
			"types": "./dist/plugin-ui/client/Parameter.svelte-types.d.ts"
		},
		"./plugin-ui/parameter-group": {
			"types": "./dist/plugin-ui/client/ParameterGroup.d.ts",
			"default": "./dist/plugin-ui/client/ParameterGroup.js"
		},
		"./plugin-ui/parameter-group/ssr": {
			"types": "./dist/plugin-ui/ssr/ParameterGroup-ssr.d.ts",
			"default": "./dist/plugin-ui/ssr/ParameterGroup-ssr.js"
		},
		"./plugin-ui/parameter-group/svelte": {
			"types": "./dist/plugin-ui/client/ParameterGroup.svelte-types.d.ts"
		}
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/montserrat": "^5.3.0",
		"@lucide/svelte": "^1.73.0",
		"@murithigeo/uriproj": "^1.0.0",
		"@playwright/test": "^1.62.1",
		"@svebcomponents/build": "^0.7.5",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.3.1",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/postcss": "^4.3.5",
		"@tailwindcss/vite": "^4.3.3",
		"@tsdown/css": "^0.23.7",
		"@turf/bbox-polygon": "^7.4.0",
		"@turf/center": "^7.4.0",
		"@turf/combine": "^7.4.0",
		"@turf/nearest-point-on-line": "^7.4.0",
		"@types/coveragejson": "^3.0.0",
		"@types/d3-scale": "^4.0.9",
		"@types/geojson": "^7946.0.16",
		"@types/ndarray": "^1.1.0",
		"@types/ndarray-ops": "^1.2.7",
		"@types/node": "^24",
		"@types/postcss-url": "^10.0.4",
		"@vitest/browser-playwright": "^4.1.12",
		"@zerodevx/svelte-json-view": "^2.0.0",
		"ajv": "^6.15.0",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"cn": "^0.5.2",
		"d3-scale": "^4.0.2",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"layerchart": "^2.9.1",
		"maplibre-gl": "^6.12.0",
		"mdsvex": "^0.12.7",
		"mode-watcher": "^1.1.0",
		"ndarray": "^1.1.1",
		"ndarray-ops": "^1.2.2",
		"netcdfjs": "^4.0.0",
		"playwright": "^1.62.1",
		"point-in-polygon-hao": "^1.2.4",
		"postcss-import": "^17.0.1",
		"postcss-url": "^10.1.4",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"publint": "^0.3.24",
		"shadcn-svelte": "^1.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.5",
		"svelte-maplibre": "^2.0.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.68.0",
		"url-template": "^3.1.1",
		"vite": "^8.3.8",
		"vitest": "^5.1.1",
		"vitest-browser-svelte": "^2.1.0"
	},
	"keywords": [
		"svelte"
	]
}
